<Project>
  <!-- Copia questo file come "Directory.Build.props" nella radice del repository
       per personalizzare la tua build. Il file è ignorato da git: puoi sempre
       fare pull delle novità senza conflitti e senza fork.

       Anche le icone non servono questo file — basta mettere "icon.custom.ico"
       accanto al csproj dell'updater o nella radice per l'editor, e
       "logo.custom.png" accanto al csproj dell'updater per il logo in alto a
       destra della finestra. Anche quelli sono ignorati da git. -->
  <PropertyGroup>
    <!-- Nome del brand: titolo delle finestre e proprietà del prodotto
         (default: KitUpdater) -->
    <BrandName>KitUpdater</BrandName>

    <!-- Nome dell'exe dell'updater (default: KitUpdater) -->
    <AssemblyName Condition="'$(MSBuildProjectName)' == 'KitUpdater'">KitUpdater</AssemblyName>

    <!-- Nome dell'exe del ManifestEditor (default: KitUpdaterEditor) -->
    <AssemblyName Condition="'$(MSBuildProjectName)' == 'KitUpdaterEditor'">KitUpdaterEditor</AssemblyName>
  </PropertyGroup>
</Project>
