<Window x:Class="KitUpdaterEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:KitUpdater.Shared"
        Title="KitUpdater — Manifest Editor" Height="760" Width="960"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Foreground="#E0E0E0"
        FontFamily="Segoe UI" Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1E1E1E"/>
                    <Setter Property="Foreground" Value="#666666"/>
                    <Setter Property="BorderBrush" Value="#2D2D30"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="BorderBrush" Value="#004A82"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0078D7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Impostazioni: accento verde per distinguerlo dai pulsanti azione -->
        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#223028"/>
            <Setter Property="BorderBrush" Value="#2E6B4B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3D33"/>
                    <Setter Property="BorderBrush" Value="#3DDC84"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1E1E1E"/>
                    <Setter Property="Foreground" Value="#666666"/>
                    <Setter Property="BorderBrush" Value="#2D2D30"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>

        <!-- Label e campi di testo scuri -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        <!-- testo su piu' righe: le etichette lunghe non devono uscire dalla finestra -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Elementi del dropdown: righe scure con hover -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox scuro: serve il template completo, quello di default
             ignora Background/Foreground e resta bianco -->
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="#0D0D0D" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#AAAAAA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#161B1E"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#555555"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="9,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              TextBlock.Foreground="#E0E0E0"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#0D0D0D" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}" Margin="0,3,0,0">
                                    <ScrollViewer Margin="2" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scrollbar -->
        <Style x:Key="DarkScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" Background="#555555" CornerRadius="3" Margin="3,0,3,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#777777"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#252526"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkListViewItem" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#333337"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#444444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>

        <!-- Header e toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock x:Name="HeaderTitle" Text="Manifest Editor" FontSize="24" FontWeight="Bold" Foreground="#F0F0F0"/>
                <TextBlock x:Name="SubtitleText" Text="" FontSize="13" Foreground="#888888"/>
            </StackPanel>

            <DockPanel Grid.Row="1" LastChildFill="False">
                <Button x:Name="BtnSettings" Content="{l:Loc '⚙  Impostazioni'}" Style="{StaticResource SettingsButton}"
                        Width="130" Height="30" DockPanel.Dock="Right" Click="BtnSettings_Click"/>
                <WrapPanel>
                    <Button Content="{l:Loc 'Nuovo'}" Width="80" Height="30" Margin="0,0,8,0" Click="BtnNew_Click"/>
                    <Button Content="{l:Loc 'Apri file...'}" Width="90" Height="30" Margin="0,0,8,0" Click="BtnOpenFile_Click"/>
                    <Button Content="{l:Loc 'Scarica da URL'}" Width="120" Height="30" Margin="0,0,8,0" Click="BtnDownloadUrl_Click"/>
                    <Button Content="{l:Loc 'Scarica da WebDAV'}" Width="130" Height="30" Margin="0,0,8,0" Click="BtnDownloadWebDav_Click"/>
                    <Button Content="{l:Loc 'Salva file...'}" Width="90" Height="30" Margin="0,0,8,0" Click="BtnSaveFile_Click"/>
                    <Button Content="{l:Loc 'Carica su WebDAV'}" Style="{StaticResource PrimaryButton}" Width="130" Height="30" Margin="0,0,8,0" Click="BtnUploadWebDav_Click"/>
                </WrapPanel>
            </DockPanel>
        </Grid>

        <!-- Corpo: tab updater / componenti / extra -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4,4,0,0" Margin="0,0,2,0" Padding="15,8">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#005A9E"/>
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#004A82"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="#AAAAAA"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
            </TabControl.Resources>

            <!-- SCHEDA UPDATER -->
            <TabItem Header="{l:Loc 'Updater'}">
                <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="0,4,4,4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock Text="{l:Loc &quot;Autoaggiornamento dell'Updater&quot;}" FontSize="16" FontWeight="Bold" Foreground="#F0F0F0" Margin="1,0,0,4"/>
                            <TextBlock Text="{l:Loc &quot;Quando la versione qui sotto è più alta di quella installata, l'updater propone di scaricarsi e riavviarsi da solo.&quot;}"
                                       FontSize="12" Foreground="#888888" Margin="1,0,0,14" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <Label Content="{l:Loc 'Versione'}"/>
                                    <TextBox x:Name="TxtUpdaterVersion" Style="{StaticResource FieldBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Label Content="{l:Loc 'URL del nuovo exe'}"/>
                                    <TextBox x:Name="TxtUpdaterUrl" Style="{StaticResource FieldBox}"/>
                                </StackPanel>
                            </Grid>
                            <Label Content="{l:Loc &quot;Descrizione / Changelog mostrata nell'autoaggiornamento&quot;}" Margin="1,10,0,0"/>
                            <TextBox x:Name="TxtUpdaterDescription" Style="{StaticResource FieldBox}" Height="180" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

                <!-- COMPONENTI -->
                <TabItem Header="{l:Loc 'Componenti'}">
                    <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="0,4,4,4">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="500"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Lista componenti -->
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListView x:Name="ComponentsList" Grid.Row="0" Background="Transparent" BorderThickness="0" Foreground="White"
                                          ItemContainerStyle="{StaticResource DarkListViewItem}" SelectionChanged="ComponentsList_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{l:Loc 'Chiave'}" DisplayMemberBinding="{Binding Key}" Width="115"/>
                                            <GridViewColumn Header="{l:Loc 'Nome'}" DisplayMemberBinding="{Binding Name}" Width="175"/>
                                            <GridViewColumn Header="{l:Loc 'Versione'}" DisplayMemberBinding="{Binding Version}" Width="75"/>
                                            <GridViewColumn Header="{l:Loc 'Cartella'}" DisplayMemberBinding="{Binding Folder}" Width="110"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                    <Button Content="{l:Loc 'Aggiungi'}" Width="75" Height="26" Margin="0,0,6,0" Click="BtnAddComponent_Click"/>
                                    <Button Content="{l:Loc 'Duplica'}" Width="70" Height="26" Margin="0,0,6,0" Click="BtnDuplicateComponent_Click"/>
                                    <Button Content="{l:Loc 'Rimuovi'}" Width="70" Height="26" Click="BtnRemoveComponent_Click"/>
                                </WrapPanel>
                            </Grid>

                            <!-- Dettaglio componente -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ComponentDetail" IsEnabled="False">
                                    <Label Content="{l:Loc 'Chiave (identificativo univoco)'}"/>
                                    <TextBox x:Name="TxtCompKey" Style="{StaticResource FieldBox}"/>
                                    <Label Content="{l:Loc 'Nome'}"/>
                                    <TextBox x:Name="TxtCompName" Style="{StaticResource FieldBox}"/>
                                    <Label Content="{l:Loc 'Descrizione'}"/>
                                    <TextBox x:Name="TxtCompDescription" Style="{StaticResource FieldBox}" Height="52" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    <Label Content="{l:Loc 'Versione'}"/>
                                    <TextBox x:Name="TxtCompVersion" Style="{StaticResource FieldBox}"/>
                                    <Label Content="{l:Loc &quot;Cartella di destinazione (vuota o . = cartella dell'updater)&quot;}"/>
                                    <TextBox x:Name="TxtCompFolder" Style="{StaticResource FieldBox}"/>
                                    <Label Content="{l:Loc 'File versione (es. run.exe — legge la versione dal file stesso)'}"/>
                                    <TextBox x:Name="TxtCompVersionFile" Style="{StaticResource FieldBox}"/>
                                    <Label Content="{l:Loc 'URL download (.zip)'}"/>
                                    <TextBox x:Name="TxtCompDownloadUrl" Style="{StaticResource FieldBox}"/>
                                    <Label Content="{l:Loc 'File da preservare (uno per riga, supporta *)'}"/>
                                    <TextBox x:Name="TxtCompPreserveFiles" Style="{StaticResource FieldBox}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- EXTRA -->
                <TabItem Header="{l:Loc 'Utility &amp; Extra'}">
                    <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="0,4,4,4">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="500"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Lista extra -->
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListView x:Name="ExtrasList" Grid.Row="0" Background="Transparent" BorderThickness="0" Foreground="White"
                                          ItemContainerStyle="{StaticResource DarkListViewItem}" SelectionChanged="ExtrasList_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{l:Loc 'Chiave'}" DisplayMemberBinding="{Binding Key}" Width="120"/>
                                            <GridViewColumn Header="{l:Loc 'Nome'}" DisplayMemberBinding="{Binding Name}" Width="250"/>
                                            <GridViewColumn Header="{l:Loc 'Azione'}" DisplayMemberBinding="{Binding Action}" Width="100"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                    <Button Content="{l:Loc 'Aggiungi'}" Width="75" Height="26" Margin="0,0,6,0" Click="BtnAddExtra_Click"/>
                                    <Button Content="{l:Loc 'Duplica'}" Width="70" Height="26" Margin="0,0,6,0" Click="BtnDuplicateExtra_Click"/>
                                    <Button Content="{l:Loc 'Rimuovi'}" Width="70" Height="26" Click="BtnRemoveExtra_Click"/>
                                </WrapPanel>
                            </Grid>

                            <!-- Dettaglio extra -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ExtraDetail" IsEnabled="False">
                                    <Label Content="{l:Loc 'Chiave (identificativo univoco)'}"/>
                                    <TextBox x:Name="TxtExtraKey" Style="{StaticResource FieldBox}"/>
                                    <Label Content="{l:Loc 'Nome'}"/>
                                    <TextBox x:Name="TxtExtraName" Style="{StaticResource FieldBox}"/>
                                    <Label Content="{l:Loc 'Descrizione'}"/>
                                    <TextBox x:Name="TxtExtraDescription" Style="{StaticResource FieldBox}" Height="52" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    <Label Content="{l:Loc 'Azione'}"/>
                                    <ComboBox x:Name="CmbExtraAction" Style="{StaticResource FieldCombo}">
                                        <ComboBoxItem Content="save_as" Tag="save_as"/>
                                        <ComboBoxItem Content="run_installer" Tag="run_installer"/>
                                        <ComboBoxItem Content="{l:Loc 'none — solo guida'}" Tag="none"/>
                                    </ComboBox>
                                    <Label Content="{l:Loc 'URL download'}"/>
                                    <TextBox x:Name="TxtExtraDownloadUrl" Style="{StaticResource FieldBox}"/>
                                    <Label Content="{l:Loc 'URL guida (facoltativo)'}"/>
                                    <TextBox x:Name="TxtExtraGuideUrl" Style="{StaticResource FieldBox}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </TabItem>
        </TabControl>

        <!-- Log -->
        <Border Grid.Row="2" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="0,10,0,0">
            <TextBox x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" Background="#0D0D0D" Foreground="#CCCCCC" BorderThickness="0" Padding="8"/>
        </Border>
    </Grid>
</Window>
