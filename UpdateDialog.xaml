<Window x:Class="Marsic1UtilityUpdater.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Marsic1UtilityUpdater.Shared"
        Title="{l:Loc 'Aggiornamento Disponibile'}" Height="280" Width="450"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="#E0E0E0"
        FontFamily="Segoe UI" ResizeMode="NoResize" Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#005A9E"/>
            <Setter Property="BorderBrush" Value="#004A82"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0078D7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{l:Loc '🚀 Nuovo Aggiornamento Updater'}" FontSize="18" FontWeight="Bold" Foreground="#4EA8DE" Grid.Row="0" Margin="0,0,0,15"/>

        <!-- Contenitore per Messaggio e Changelog -->
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="TxtMessage" TextWrapping="Wrap" FontSize="14" Foreground="#CCCCCC" Margin="0,0,0,10"/>

            <!-- Riquadro Scuro per la Descrizione -->
            <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="60" Margin="0" Padding="0,0,5,0">
                    <TextBlock x:Name="TxtChangelog" TextWrapping="Wrap" FontSize="13" Foreground="#AAAAAA" FontStyle="Italic"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Pulsanti -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{l:Loc 'No, più tardi'}" Width="100" Margin="0,0,10,0" Click="BtnNo_Click"/>
            <Button Content="{l:Loc 'Sì, aggiorna ora'}" Width="140" Style="{StaticResource PrimaryButton}" Click="BtnYes_Click"/>
        </StackPanel>
    </Grid>
</Window>